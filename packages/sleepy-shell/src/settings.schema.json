{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": {"const": "left"},
        "width": {"const": 52},
        "alwaysVisible": {"const": true}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"name": {"const": "lunar-minimal"}}
    }
  }
}
